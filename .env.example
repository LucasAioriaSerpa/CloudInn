# =====================================================================
# CloudInn — Configurações e Variáveis de Ambiente
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND EXCLUSIVO: Azure Functions & MongoDB
# NUNCA exponha esta variável no bundle do frontend.
# Em produção, configure no Application Settings de cada Azure Function:
# MONGO_BD_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# ---------------------------------------------------------------------
MONGO_BD_URI=
MONGO_DB_NAME=cloudinn

# ---------------------------------------------------------------------
# FRONTEND: Azure Static Web Apps (Vite)
# Variáveis públicas injetadas durante o build (prefixo VITE_)
# ---------------------------------------------------------------------
VITE_CLOUDINN_SELECT_URL=
VITE_CLOUDINN_INSERT_URL=
VITE_CLOUDINN_UPDATE_URL=
VITE_CLOUDINN_DELETE_URL=
VITE_CLOUDINN_HEALTH_URL=

VITE_API_BASE_URL=
VITE_API_KEY=

# Chave para modelos generativos de IA (se aplicável)
GEMINI_API_KEY=
