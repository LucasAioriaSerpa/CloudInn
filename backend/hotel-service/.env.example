# Hotel Service CloudInn — copie para .env (ignorado pelo Git) e preencha.
# Este arquivo é versionado: nunca coloque valores reais aqui.

# Porta HTTP. Padrão: 5001.
PORT=5001

# Nível de log: debug, info, warn ou error. Padrão: info.
LOG_LEVEL=info

# --- MongoDB (obrigatórias) ---
# Atlas → Database → Connect → Drivers. Use um usuário novo, não o exposto no histórico do Git.
# Em Network Access, libere o IP de onde o serviço roda.
MONGODB_URI=
# Nome do banco no Atlas (ex.: cloudinn).
MONGODB_DB_NAME=

# --- Seed de demonstração (usada só por: npm run seed -- --yes) ---
# Senha dos 4 funcionários de demonstração. Mínimo de 8 caracteres. Definida pelo grupo.
SEED_STAFF_PASSWORD=

# --- Teste de integração (usada só por: npm run test:mongo) ---
# URI de um MongoDB onde o teste pode criar e apagar um banco temporário.
# MONGODB_TEST_URI=

# --- Chamadas do BFF ---
# Mesma chave configurada no BFF. Obrigatória com NODE_ENV=production; sem ela, as rotas ficam abertas.
INTERNAL_API_KEY=

# --- Eventos (Azure Service Bus) ---
# servicebus: publica e consome eventos (obrigatório com NODE_ENV=production).
# log: só registra eventos no log, sem consumo (apenas desenvolvimento local).
EVENT_PUBLISHER=log
# Portal Azure → Service Bus → Shared access policies (permissões Send e Listen). Obrigatória com EVENT_PUBLISHER=servicebus.
SERVICEBUS_CONNECTION=
# Nomes do tópico e da assinatura. Padrões: cloudinn.domain.events e sub-hotel-service.
# SERVICEBUS_TOPIC=cloudinn.domain.events
# SERVICEBUS_SUBSCRIPTION=sub-hotel-service
