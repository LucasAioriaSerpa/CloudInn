# ==============================================================================
# CloudInn Hotel Service - Variáveis de Ambiente (.env.example)
# NUNCA insira valores reais ou segredos neste arquivo.
# ==============================================================================

# Porta TCP do serviço (padrão 5001)
# Obter: configuração local ou container OpenShift
PORT=5001

# URI de conexão com o cluster MongoDB Atlas (mongodb+srv://...)
# Obter: MongoDB Atlas -> Clusters -> Connect -> Drivers (Node.js)
MONGODB_URI=

# Nome do banco de dados no MongoDB Atlas
# Obter: MongoDB Atlas -> Database -> Collections (ex: cloudinn_hotel)
MONGODB_DB_NAME=

# Chave secreta de autenticação interna recebida no header x-internal-api-key
# Obter: Gerar com 'openssl rand -hex 32' e salvar no cofre de Secrets
INTERNAL_API_KEY=

# String de conexão do Azure Service Bus com permissão de envio/escuta no tópico
# Obter: Portal Azure -> Service Bus Namespace -> Shared access policies (RootManageSharedAccessKey)
SERVICEBUS_CONNECTION=

# Mecanismo de publicação de eventos ('servicebus' para nuvem ou 'log' apenas para testes locais)
# NOTA: O valor 'log' é estritamente proibido quando NODE_ENV=production
EVENT_PUBLISHER=servicebus

# Senha do usuário de demonstração/seed administrativo (apenas para carga inicial)
# Obter: Definida pelo grupo apenas durante execução manual do seed
SEED_STAFF_PASSWORD=
