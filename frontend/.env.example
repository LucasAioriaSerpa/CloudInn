# ==============================================================================
# CloudInn Frontend - Variáveis de Build/Execução (.env.example)
# NUNCA insira valores reais ou segredos neste arquivo.
# ==============================================================================

# URL pública de entrada do API Gateway (AWS API Gateway ou Azure Static Web Apps)
# Obter: AWS API Gateway -> Stages -> Invoke URL (ex: https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod)
VITE_API_BASE_URL=

# Chave pública/API Key exigida pelo API Gateway no cabeçalho x-api-key
# Obter: AWS API Gateway -> API Keys -> API key value
VITE_API_KEY=

# Ativação do modo de demonstração local com dados estáticos em memória/localStorage
# Padrão: false (em produção e homologação deve ser 'false' para integração real)
VITE_ENABLE_MOCK=false
