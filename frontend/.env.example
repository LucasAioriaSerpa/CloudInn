# =====================================================================
# CloudInn Frontend — Variáveis de Ambiente (.env.example)
# =====================================================================

# URLs diretas das Azure Functions (Deploy na nuvem ou emulador local)
# Se não preenchidas, o frontend utilizará os caminhos relativos padrão /api/httpTrigger*
VITE_CLOUDINN_SELECT_URL=
VITE_CLOUDINN_INSERT_URL=
VITE_CLOUDINN_UPDATE_URL=
VITE_CLOUDINN_DELETE_URL=
VITE_CLOUDINN_HEALTH_URL=

# URL Base para API REST / Gateway alternativo (ex: https://api.cloudinn.hotel)
VITE_API_BASE_URL=

# Chave de segurança opcional de cabeçalho para endpoints protegidos (api_key)
VITE_API_KEY=
