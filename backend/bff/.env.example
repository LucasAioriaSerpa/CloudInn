# BFF CloudInn — copie para .env (ignorado pelo Git) e preencha.
# Este arquivo é versionado: nunca coloque valores reais aqui.

# Porta HTTP. Padrão: 4000.
PORT=4000

# Nível de log: debug, info, warn ou error. Padrão: info.
LOG_LEVEL=info

# --- Serviços chamados pelo BFF (obrigatórias) ---
# URL do Hotel Service. Local: http://localhost:5001. Nuvem: rota do OpenShift do hotel-service.
HOTEL_SERVICE_URL=
# URL do Reservas Service. Local: http://localhost:5002. Nuvem: rota do OpenShift do reservations-service.
RESERVATIONS_SERVICE_URL=
# Endpoint completo da Function, SEM o ?code=.
# Portal Azure → Function App → Functions → httpTriggerAnalytics → Get function URL.
ANALYTICS_FUNCTION_URL=
# Chave da Function (enviada no cabeçalho x-functions-key). Portal Azure → Function App → App keys.
ANALYTICS_FUNCTION_KEY=
# Chave compartilhada com Hotel e Reservas (mesmo valor nos três). Gere com: openssl rand -hex 32
INTERNAL_API_KEY=

# --- Login (obrigatória) ---
# Segredo para assinar os JWTs, com pelo menos 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=
# Validade do token. Padrão: 8h.
# JWT_EXPIRES_IN=8h

# --- Navegador ---
# Origens que podem chamar o BFF, separadas por vírgula (ex.: URL do frontend publicado, sem barra final).
# Obrigatória com NODE_ENV=production.
CORS_ORIGINS=

# Tempo máximo por chamada a serviços dependentes, em ms. Padrão: 10000.
# DOWNSTREAM_TIMEOUT_MS=10000
