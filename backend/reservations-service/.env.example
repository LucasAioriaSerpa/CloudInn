# Reservas Service CloudInn — copie para .env (ignorado pelo Git) e preencha.
# Este arquivo é versionado: nunca coloque valores reais aqui.

# Porta HTTP. Padrão: 5002.
PORT=5002

# Nível de log: debug, info, warn ou error. Padrão: info.
LOG_LEVEL=info

# --- Banco: preencha UMA das opções (decisão D9) ---

# Opção 1 (necessária fora do Azure, como no OpenShift): connection string com login SQL.
# Portal Azure → SQL Database → Connection strings → ADO.NET. Substitua a senha no texto copiado.
AZURE_SQL_CONNECTION_STRING=

# Opção 2: login Microsoft Entra. Usada somente se a opção 1 estiver vazia.
# Portal Azure → SQL server → Overview → Server name (ex.: nome.database.windows.net).
DB_SERVER=
DB_PORT=1433
# Nome do banco de dados.
DB_DATABASE=
# Na sua máquina, o login Entra usa a sessão do `az login`. Fora do Azure, informe também
# AZURE_TENANT_ID, AZURE_CLIENT_ID e AZURE_CLIENT_SECRET de um service principal com acesso ao banco.

# --- Teste de integração (usadas só por: npm run test:sql) ---
# Connection string de um banco DESCARTÁVEL: o teste aplica as migrações e grava dados nele.
# SQL_TEST_CONNECTION_STRING=
# Confirmação explícita de que o banco acima pode receber escrita.
# SQL_TEST_ALLOW_WRITE=yes

# --- Chamadas do BFF ---
# Mesma chave configurada no BFF. Obrigatória com NODE_ENV=production; sem ela, as rotas ficam abertas.
INTERNAL_API_KEY=

# --- Eventos (Azure Service Bus) ---
# servicebus: publica e consome eventos (obrigatório com NODE_ENV=production).
# log: só registra eventos no log, sem consumo (apenas desenvolvimento local).
EVENT_PUBLISHER=log
# Portal Azure → Service Bus → Shared access policies (permissões Send e Listen). Obrigatória com EVENT_PUBLISHER=servicebus.
SERVICEBUS_CONNECTION=
# Nomes do tópico e da assinatura. Padrões: cloudinn.domain.events e sub-reservations-service.
# SERVICEBUS_TOPIC=cloudinn.domain.events
# SERVICEBUS_SUBSCRIPTION=sub-reservations-service
