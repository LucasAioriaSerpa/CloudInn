# ==============================================================================
# CloudInn - Variáveis de Ambiente Consolidadas (.env.example)
# NUNCA comite segredos ou valores reais. Use este arquivo como referência.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Gateway e Frontend (Vite)
# ------------------------------------------------------------------------------
# URL pública do AWS API Gateway (REST API na frente do BFF)
# Obter: AWS API Gateway -> Stages -> Invoke URL
VITE_API_BASE_URL=

# Chave de acesso do API Gateway (cabeçalho x-api-key)
# Obter: AWS API Gateway -> API Keys -> Chave criada
VITE_API_KEY=

# Ativar mock local (true apenas para testes isolados sem backend; false para integração real)
VITE_ENABLE_MOCK=false

# ------------------------------------------------------------------------------
# 2. BFF (Backend for Frontend)
# ------------------------------------------------------------------------------
PORT_BFF=4000
HOTEL_SERVICE_URL=
RESERVATIONS_SERVICE_URL=
ANALYTICS_FUNCTION_URL=
ANALYTICS_FUNCTION_KEY=
INTERNAL_API_KEY=
JWT_SECRET=
CORS_ORIGINS=
DOWNSTREAM_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. Hotel Service (MongoDB Atlas)
# ------------------------------------------------------------------------------
PORT_HOTEL=5001
MONGODB_URI=
MONGODB_DB_NAME=
SEED_STAFF_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Reservas Service (Azure SQL Database)
# ------------------------------------------------------------------------------
PORT_RESERVAS=5002
AZURE_SQL_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# 5. Mensageria e Eventos (Azure Service Bus Standard)
# ------------------------------------------------------------------------------
# Connection string do Service Bus com políticas de Envio e Escuta no tópico
# Obter: Portal Azure -> Service Bus -> Shared access policies
SERVICEBUS_CONNECTION=
EVENT_PUBLISHER=servicebus