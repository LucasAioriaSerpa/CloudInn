# ==============================================================================
# CloudInn BFF - Variáveis de Ambiente (.env.example)
# NUNCA insira valores reais ou segredos neste arquivo.
# ==============================================================================

# Porta TCP local do BFF (padrão 4000)
# Obter: configuração local ou container OpenShift
PORT=4000

# URL do Hotel Service (MongoDB)
# Obter: URL gerada pelo OpenShift (ex: https://hotel-service-<ns>.apps.<cluster>)
HOTEL_SERVICE_URL=

# URL do Reservas Service (Azure SQL)
# Obter: URL gerada pelo OpenShift (ex: https://reservations-service-<ns>.apps.<cluster>)
RESERVATIONS_SERVICE_URL=

# URL da Azure Function de Analytics
# Obter: Portal Azure -> Function App -> Visão geral -> URL (com /api/calculate)
ANALYTICS_FUNCTION_URL=

# Chave de acesso da Azure Function (Function Key)
# Obter: Portal Azure -> Function App -> App keys
ANALYTICS_FUNCTION_KEY=

# Chave secreta compartilhada para comunicação interna entre BFF e microsserviços
# Obter: Gerar com 'openssl rand -hex 32' e salvar no cofre de Secrets
INTERNAL_API_KEY=

# Segredo para assinatura e validação de tokens JWT emitidos no /auth/login
# Obter: Gerar com 'openssl rand -hex 32' e salvar no cofre de Secrets
JWT_SECRET=

# Origens permitidas para requisições do frontend (separadas por vírgula)
# Obter: URL do frontend no Azure Static Web Apps (ex: https://lemon-coast-0f8dbc70f.azurestaticapps.net)
CORS_ORIGINS=

# Timeout máximo em milissegundos para chamadas aos microsserviços downstream (padrão 5000)
# Obter: definir tempo de tolerância de latência
DOWNSTREAM_TIMEOUT_MS=5000
