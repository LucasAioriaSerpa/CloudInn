# Modelo para npm run check:integration.
# Copie para .env.integration na raiz do projeto (ignorado pelo Git) e preencha com as URLs públicas.

# Rota pública do BFF no OpenShift (ou URL do Gateway, se o BFF só for acessível por ele).
CHECK_BFF_URL=
# Rotas dos microservices no OpenShift.
CHECK_HOTEL_URL=
CHECK_RESERVATIONS_URL=
# Endpoint httpTriggerAnalytics da Function, SEM o ?code=.
CHECK_FUNCTION_URL=
# URL pública do API Gateway (Fase 10).
CHECK_GATEWAY_URL=
# Chave de uso do Gateway. Fica só neste arquivo local.
CHECK_API_KEY=
# Hotel e data usados no teste de /aggregated-data (ex.: 2026-11-09).
# O hotelId é exibido pelo seed do Hotel Service (npm run seed -- --yes).
CHECK_HOTEL_ID=
CHECK_DATE=
# Login de um funcionário (ex.: um dos criados pelo seed). Fica só neste arquivo local.
CHECK_LOGIN=
CHECK_PASSWORD=
