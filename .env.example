# CloudInn — as variáveis ficam no .env.example de cada componente:
#
#   backend/bff/.env.example
#   backend/hotel-service/.env.example
#   backend/reservations-service/.env.example
#   backend/api/functions/analytics-function/local.settings.json.example
#   frontend/.env.example
