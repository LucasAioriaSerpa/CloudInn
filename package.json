{
  "name": "cloudinn-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && rm -rf dist && cp -r frontend/dist dist",
    "preview": "npm run preview --workspace=frontend",
    "start:functions": "node backend/dev-server.js",
    "test:functions": "node --test backend/api/functions/*/test/*.test.js"
  }
}
