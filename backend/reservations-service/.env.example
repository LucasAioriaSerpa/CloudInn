# ==============================================================================
# CloudInn Reservas Service - Variáveis de Ambiente (.env.example)
# NUNCA insira valores reais ou segredos neste arquivo.
# ==============================================================================

# Porta TCP do serviço (padrão 5002)
# Obter: configuração local ou container OpenShift
PORT=5002

# String de conexão completa com o Azure SQL Database (Server=tcp:...;Database=...;User Id=...;Password=...;Encrypt=true;)
# Obter: Portal Azure -> SQL Database -> Connection strings -> ADO.NET / Node.js
AZURE_SQL_CONNECTION_STRING=

# Chave secreta de autenticação interna recebida no header x-internal-api-key
# Obter: Gerar com 'openssl rand -hex 32' e salvar no cofre de Secrets
INTERNAL_API_KEY=

# String de conexão do Azure Service Bus para envio/escuta no tópico
# Obter: Portal Azure -> Service Bus Namespace -> Shared access policies (RootManageSharedAccessKey)
SERVICEBUS_CONNECTION=

# Mecanismo de publicação de eventos ('servicebus' para nuvem ou 'log' apenas para testes locais)
# NOTA: O valor 'log' é estritamente proibido quando NODE_ENV=production
EVENT_PUBLISHER=servicebus
