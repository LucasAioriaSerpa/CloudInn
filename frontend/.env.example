# Frontend CloudInn — copie para .env (ignorado pelo Git) e preencha.
# Variáveis VITE_ entram no código publicado: nunca coloque segredos aqui.
# No deploy, configure os mesmos nomes em GitHub → Settings → Secrets and variables → Actions.

# --- Usadas pelo código atual (substituídas na Fase 7) ---
# Endpoints das Functions antigas de CRUD. Vazios = rotas /api/httpTrigger* do próprio site.
VITE_CLOUDINN_SELECT_URL=
VITE_CLOUDINN_INSERT_URL=
VITE_CLOUDINN_UPDATE_URL=
VITE_CLOUDINN_DELETE_URL=
VITE_CLOUDINN_HEALTH_URL=
# Mock do Apidog usado no "Restaurar dados demo".
VITE_MOCK_API_URL=

# --- Passam a valer na Fase 7 ---
# URL pública do API Gateway.
VITE_API_BASE_URL=
# Chave de uso do API Gateway. É pública por natureza: serve para identificação e limite de requisições.
VITE_API_KEY=
# true apenas para demonstrar sem backend. Padrão: false.
# VITE_ENABLE_MOCK=false
